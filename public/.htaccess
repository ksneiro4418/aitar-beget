# SPA-роутинг для React (BrowserRouter) на Apache-хостинге Beget.
# Аналог public/_redirects (он работает только на Netlify): все несуществующие
# пути отдаются через index.html, чтобы клиентский роутер отрисовал нужный экран.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Реально существующие файлы и папки отдаём как есть
  # (assets/, /admin/, /uploads/, *.jpg, content/*.json и т.д.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Всё остальное — на index.html (точка входа SPA)
  RewriteRule ^ index.html [L]
</IfModule>

# Кодировка по умолчанию для текстовых ответов
AddDefaultCharset UTF-8

# Gzip-сжатие текстовых ресурсов (если модуль доступен)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>

# Кэширование статики. index.html не кэшируем, чтобы новые сборки подхватывались сразу.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
